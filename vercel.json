{
  "buildCommand": "pip install -r requirements.txt",
  "devCommand": "uvicorn api.index:app --reload --port 8000",
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}